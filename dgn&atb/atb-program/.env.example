# atb-program 환경설정 템플릿.
# 복사해서 .env 로 만들고 값을 채운다:  cp .env.example .env

# ─── 공공데이터포털 ────────────────────────────────────────────────────────────
# https://www.data.go.kr 계정당 인증키 1개(일반 인증키).
# 서비스별 '활용신청'으로 사용 권한이 붙는다 (키 값 자체는 동일).
# 필요한 서비스:
#   - 아파트 매매 실거래가 자료          (1613000)
#   - 공동주택 단지 목록제공 서비스       (1611000)  https://www.data.go.kr/data/15057332/openapi.do
#   - 공동주택 기본 정보제공 서비스       (1611000)  https://www.data.go.kr/data/15058453/openapi.do
DATA_AUTH_KEY=""

# ─── 네이버 검색 API (아파트 이미지) ───────────────────────────────────────────
# https://developers.naver.com 애플리케이션 등록 > 검색 API
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""

# ─── MySQL ────────────────────────────────────────────────────────────────────
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="atb_db"

# ─── Tesseract OCR (선택) ─────────────────────────────────────────────────────
# 미지정 시 표준 설치경로 → PATH 순으로 자동 탐색.
# TESSERACT_EXE="C:\Program Files\Tesseract-OCR\tesseract.exe"

# ─── 지오코딩 (행정안전부 주소정보누리집) ─────────────────────────────────────
# business.juso.go.kr 에서 두 API 를 각각 신청한다 (자동승인, 무료).
#   - 도로명주소 검색 API  → JUSO_SEARCH_KEY
#   - 좌표제공 API        → JUSO_COORD_KEY
# 상용 지오코더(VWorld·카카오)는 좌표의 DB 저장을 약관으로 막아 쓸 수 없다.
JUSO_SEARCH_KEY=""
JUSO_COORD_KEY=""
